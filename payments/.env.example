# Database connection (injected from the Secure Vault at deploy; never commit values)
PAYMENTS_DB_HOST=127.0.0.1
PAYMENTS_DB_PORT=5432
PAYMENTS_DB_NAME=lampy_payments
PAYMENTS_DB_USER=payments_app
PAYMENTS_DB_PASSWORD=

# 32-byte AES-256 key, base64-encoded. Generate once, store in the Secure Vault.
# Generate with: python -c "from payments.crypto import generate_key_b64; print(generate_key_b64())"
PAYMENTS_ENC_KEY=

# Provider webhook signing secret (from the provider dashboard, via Secure Vault)
PAYMENTS_WEBHOOK_SECRET=
